# ============================================================
# DentaCare - Environment Configuration
# Copy to .env and fill in real values for production
# ============================================================

# Database
DATABASE_URL="postgresql://dentacare:dentacare_dev_password@localhost:5432/dentacare?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_use_openssl_rand_base64_64"
JWT_EXPIRATION="8h"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_use_openssl_rand_base64_64"
JWT_REFRESH_EXPIRATION="7d"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET="dentacare"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9000/dentacare"

# App
APP_PORT=4000
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Clinic defaults
DEFAULT_TIMEZONE="Asia/Tashkent"
DEFAULT_LOCALE="uz"

# Email (dev: console sink)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS (dev: console sink)
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_FROM=""

# Telegram bot (dev: console sink)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# First owner setup
OWNER_EMAIL="admin@dentacare.local"
OWNER_PASSWORD="CHANGE_ME_admin_password"
