# StomoApp Telegram Bot Configuration
BOT_TOKEN=CHANGE_ME_from_BotFather
# Reception & owner notifications Telegram group id (empty = no group messages)
STAFF_GROUP_CHAT_ID=

# NestJS Backend API & Service Token Authentication (Must be >= 32 characters)
BACKEND_API_URL=http://localhost:3001/api
# Same value as SERVICE_TOKEN in backend/.env; generate with: openssl rand -hex 32
SERVICE_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Clinic details: fallbacks only, the bot reads real contacts from the API.
# Leave empty rather than inventing values.
CLINIC_NAME=""
CLINIC_PHONE=""
CLINIC_LOCATION_URL=""
CLINIC_TIMEZONE="Asia/Tashkent"
