# ==============================================================================
# DentaCare Backend Environment Configuration (.env.example)
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://dentacare:dentacare_dev_password@localhost:5432/dentacare?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT secrets: at least 32 characters, different from each other, never committed.
# Generate each with: openssl rand -hex 32   (the backend refuses to start with these placeholders)
JWT_SECRET="CHANGE_ME_openssl_rand_hex_32"
JWT_EXPIRATION="8h"
JWT_REFRESH_SECRET="CHANGE_ME_openssl_rand_hex_32_refresh"
JWT_REFRESH_EXPIRATION="7d"

# Storage
STORAGE_DRIVER="local"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET="dentacare"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9000/dentacare"

# App
APP_PORT=4000
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Clinic Defaults
DEFAULT_TIMEZONE="Asia/Tashkent"
DEFAULT_LOCALE="uz"

# Email (dev: console sink)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS (dev: console sink, prod: eskiz or playmobile)
SMS_PROVIDER="eskiz"
SMS_API_URL="https://notify.eskiz.uz/api/message/sms/send"
SMS_API_KEY=""
SMS_FROM="4546"

# Telegram Bot (dev: console sink)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Bot & internal services token: at least 32 characters, same value in bot/.env.
# Generate with: openssl rand -hex 32   (placeholders are refused)
SERVICE_TOKEN="CHANGE_ME_openssl_rand_hex_32"

# Initial Owner Setup
OWNER_EMAIL="admin@dentacare.local"
OWNER_PASSWORD="ChangeMeInProduction2026!"


# Machine translation for admin content (uz <-> ru). One of:
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Public Google endpoint fallback (defaults to on outside production)
# TRANSLATE_FREE_FALLBACK=false
