# ==============================================================================
# DentaCare Backend Environment Configuration (.env.example)
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://dentacare:dentacare_dev_password@localhost:5432/dentacare?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (Generate secure base64 random strings for production)
JWT_SECRET="stomoapp_super_secret_jwt_key_2026_dev_secure_random_base64_string_1234567890"
JWT_EXPIRATION="8h"
JWT_REFRESH_SECRET="stomoapp_super_secret_refresh_key_2026_dev_secure_random_base64_string_0987654321"
JWT_REFRESH_EXPIRATION="7d"

# Storage
STORAGE_DRIVER="local"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET="dentacare"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9000/dentacare"

# App
APP_PORT=4000
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Clinic Defaults
DEFAULT_TIMEZONE="Asia/Tashkent"
DEFAULT_LOCALE="uz"

# Email (dev: console sink)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS (dev: console sink, prod: eskiz or playmobile)
SMS_PROVIDER="eskiz"
SMS_API_URL="https://notify.eskiz.uz/api/message/sms/send"
SMS_API_KEY=""
SMS_FROM="4546"

# Telegram Bot (dev: console sink)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Initial Owner Setup
OWNER_EMAIL="admin@dentacare.local"
OWNER_PASSWORD="ChangeMeInProduction2026!"

