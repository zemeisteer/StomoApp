# StomoApp FastAPI Backend Environment Variables
APP_ENV=production
DEBUG=false
SECRET_KEY=stomo_secret_key_production_dental_care_2026_jwt_token_auth
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with asyncpg or fallback to SQLite)
# Example PostgreSQL URL: postgresql+asyncpg://postgres:postgres@localhost:5432/stomo_db
DATABASE_URL=sqlite+aiosqlite:///./stomo_app.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://stomoapp.uz"]

# Clinic Owner & Reception Notification Settings
CLINIC_TIMEZONE=Asia/Tashkent
PORT=8000
HOST=0.0.0.0
