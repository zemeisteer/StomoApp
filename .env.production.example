# ==============================================================================
# DENTACARE PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# Copy this file to .env.production on your production server.
# Ensure all secrets are cryptographically random strings (>= 32 chars).
# docker compose refuses to start if any required secret is missing.
# Passwords are embedded in connection URLs: use URL-safe values, e.g.
#   openssl rand -hex 32
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=dentacare
POSTGRES_PASSWORD=generate_strong_password_here_min_32_chars
POSTGRES_DB=dentacare

# Cache & Locks (Redis 7)
REDIS_PASSWORD=generate_strong_redis_password_here_min_32_chars

# Authentication & Security
# Generate using: openssl rand -base64 32
JWT_SECRET=generate_strong_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=generate_strong_jwt_refresh_secret_min_32_chars

# Internal Inter-service Authentication (Backend <-> Telegram Bot)
# MUST be at least 32 characters long
SERVICE_TOKEN=generate_strong_service_token_min_32_chars

# Clinic Defaults & Localization
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LOCALE=uz

# Public domain & HTTPS (Let's Encrypt)
# DNS A/AAAA records for DOMAIN and every EXTRA_DOMAINS entry must point to the server.
# EXTRA_DOMAINS is space-separated and redirects to DOMAIN (leave empty if none).
DOMAIN=dentacare.uz
EXTRA_DOMAINS=www.dentacare.uz
LETSENCRYPT_EMAIL=admin@dentacare.uz

# Production URLs (API is served on the same domain under /api via nginx)
APP_URL=https://dentacare.uz
FRONTEND_URL=https://dentacare.uz
NEXT_PUBLIC_API_URL=/api

# SMS Gateway (Eskiz / PlayMobile / Infobip)
SMS_PROVIDER=eskiz
SMS_API_KEY=your_production_sms_api_token
SMS_API_URL=https://notify.eskiz.uz/api

# Telegram bot (patient portal + clinic staff alerts)
# The bot container uses TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID unless
# BOT_TOKEN / STAFF_GROUP_CHAT_ID are set to use a separate patient bot.
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token
TELEGRAM_CHAT_ID=-1001234567890
# BOT_TOKEN=
# STAFF_GROUP_CHAT_ID=

# Clinic details shown by the bot
CLINIC_NAME="DentaCare Stomatologiya Klinikasi"
CLINIC_PHONE="+998 71 200 55 44"
CLINIC_LOCATION_URL=https://maps.google.com/?q=41.311081,69.240562
# Address, branches, hours and phones come from Admin > Settings (clinic settings & branches);
# the values above are only fallbacks if the backend is unreachable.
CLINIC_WEBSITE=


# Scheduled backups (backup service): database dump + uploads archive
# Sync BACKUP_HOST_DIR offsite from the host (e.g. rclone/rsync cron).
BACKUP_HOST_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# Uploads storage: "local" (prod_backend_uploads volume, included in backups) or "s3"
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=dentacare
# S3_PUBLIC_URL=

# Bot username (without @) for staff "Connect Telegram" deep links in the admin panel
TELEGRAM_BOT_USERNAME=

# Technical alerts (failed SMS/Telegram/email in the last 30 min). Empty = TELEGRAM_CHAT_ID
OPS_TELEGRAM_CHAT_ID=

# Online payments (optional). Leave empty to disable a provider.
# Payme Business cabinet: endpoint https://<DOMAIN>/api/payments/payme, account field "invoice_id".
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_MODE=false
# CLICK merchant cabinet: Prepare URL https://<DOMAIN>/api/payments/click/prepare,
# Complete URL https://<DOMAIN>/api/payments/click/complete.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
